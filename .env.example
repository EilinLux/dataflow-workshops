# ==============================================================================
# Google Cloud Dataflow Workshop — Example Configuration (.env.example)
# Copy this file to `.env` and replace with your actual GCP project values:
#   cp .env.example .env
# ==============================================================================

# --- 1. Core Google Cloud Project Settings ---
GCP_PROJECT_ID="poc-example-ds"
GCP_REGION="europe-west1"
GCP_ZONE="europe-west1-b"
BQ_LOCATION="EU"

# --- 2. Cloud Storage Buckets (Staging & Temp) ---
DATAFLOW_BUCKET="example-dataflow-workshop"
DATAFLOW_STAGING_LOCATION="gs://example-dataflow-workshop/staging"
DATAFLOW_TEMP_LOCATION="gs://example-dataflow-workshop/temp"

# --- 3. BigQuery Settings ---
BQ_DATASET_ID="example_dataflow_workshop"
BQ_INPUT_TABLE_ID="poc-example-ds.example_dataflow_workshop.raw_events"
BQ_OUTPUT_TABLE_ID="poc-example-ds.example_dataflow_workshop.curated_metrics"

# --- 4. Pub/Sub Streaming Settings ---
PUBSUB_TOPIC="projects/poc-example-ds/topics/retail-sales-stream"
PUBSUB_SUBSCRIPTION="projects/poc-example-ds/subscriptions/retail-sales-dataflow-sub"

# --- 5. Dataflow Worker & Runner Configuration ---
DATAFLOW_RUNNER="DataflowRunner" # or DirectRunner for local testing
DATAFLOW_WORKER_MACHINE_TYPE="n1-standard-2"
DATAFLOW_MAX_WORKERS="5"
DATAFLOW_NETWORK="default"
DATAFLOW_SUBNET="default"
